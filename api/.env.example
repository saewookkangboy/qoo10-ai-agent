# ============================================================================
# Qoo10 AI Agent 환경 변수 설정 예시
# ============================================================================
# 이 파일을 .env로 복사하여 실제 값을 설정하세요.
#   cp .env.example .env
#
# 보안 주의: .env 파일은 절대 Git에 커밋하지 마세요!
# ============================================================================

# ============================================================================
# 필수 환경 변수
# ============================================================================

# 데이터베이스 연결 URL
# PostgreSQL: postgresql://user:password@host:port/database
# SQLite: sqlite:///crawler_data.db (기본값)
DATABASE_URL=postgresql://user:password@localhost:5432/qoo10_db

# SQLite 잠금 대기 시간(초). 기본 5초. API 요청 블로킹 완화용 (SQLite 사용 시만)
# SQLITE_TIMEOUT=5.0

# ============================================================================
# 서버 설정
# ============================================================================

# API 서버 포트 번호
PORT=8080

# CORS 허용 오리진 목록 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:3000,https://example.com

# ============================================================================
# 임베딩 서비스 설정
# ============================================================================

# 사용할 임베딩 모델 이름
# 옵션: bge-m3, multilingual-e5-base, multilingual-e5-small, paraphrase-multilingual
EMBEDDING_MODEL=bge-m3

# 앙상블 모드 (BGE-M3 + Multilingual-E5-Base). 0이면 보완 모델 미로드로 기동 빠름
# 옵션: 1 (활성화, 첫 실행 시 보완 모델 ~1.1GB 다운로드), 0 (비활성화)
EMBEDDING_ENSEMBLE=1

# 자동 학습 기능 활성화 여부 (크롤링 시 자동으로 임베딩 저장)
# 옵션: 1 (활성화), 0 (비활성화)
EMBEDDING_AUTO_LEARN=1

# ============================================================================
# 크롤러 설정
# ============================================================================

# 프록시 서버 목록 (쉼표로 구분)
# 형식: http://proxy1:port,http://proxy2:port
PROXY_LIST=

# 크롤러 디버그 로그 활성화 여부
# 옵션: 1 (활성화), 0 (비활성화)
CRAWLER_DEBUG_LOG=0

# 크롤러 디버그 로그 파일 경로
CRAWLER_DEBUG_LOG_PATH=.cursor/debug.log

# ============================================================================
# AI 서비스 API 키 (필요시 설정)
# ============================================================================
# 보안: API 키는 .env에만 설정하고 Git에 커밋하지 마세요.
# dev-agent-kit 가이드: 환경 변수로만 관리, 코드/문서에 실제 키 금지.

# OpenAI API 키
# 용도: 분석 강화, 채팅, 추천 생성 (AI_PROVIDER=openai 또는 Gemini 미설정 시 폴백)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini API 키
# 용도: 분석 강화, 채팅, 추천 생성 (기본 우선 사용)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic API 키 (선택)
# 용도: 향후 Claude 연동 시 사용
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Qoo10 공식 API 키 (선택)
# 미설정 시 크롤링만 사용. 설정 시 API로 상품 정보 보강
# QOO10_API_KEY=

# ============================================================================
# AI 제공자 및 모델 설정 (선택)
# ============================================================================

# AI 제공자 우선순위: gemini | openai
# - gemini: GEMINI_API_KEY 사용, 없으면 OPENAI_API_KEY로 폴백
# - openai: OPENAI_API_KEY만 사용 (Gemini 미사용)
AI_PROVIDER=gemini

# OpenAI 모델 (비용/성능 조절)
# 예: gpt-4o-mini (저비용), gpt-4o (고성능)
AI_MODEL_OPENAI=gpt-4o-mini

# Gemini 모델 (비용/성능 조절)
# 예: gemini-2.5-flash (저비용), gemini-2.5-pro (고성능)
AI_MODEL_GEMINI=gemini-2.5-flash

# AI 호출 시 최대 출력 토큰 (선택, 비워두면 서비스 기본값)
# AI_MAX_TOKENS=1024
